# 애플리케이션 환경 (development | production)
APP_ENV=development

# HTTP 서버 포트
HTTP_PORT=8080

# DB 드라이버 (sqlite | postgres)
DB_DRIVER=sqlite

# sqlite 사용 시 데이터 파일 경로
SQLITE_PATH=cms.db

# postgres 사용 시 DSN (DB_DRIVER=postgres 일 때만 사용)
# DB_DSN=host=localhost user=cms password=cms dbname=cms port=5432 sslmode=disable TimeZone=Asia/Seoul
DB_DSN=
