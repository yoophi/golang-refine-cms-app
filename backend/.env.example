# 애플리케이션 환경 (development | production)
APP_ENV=development

# HTTP 서버 포트
HTTP_PORT=8080

# DB 드라이버 (sqlite | postgres)
DB_DRIVER=sqlite

# sqlite 사용 시 데이터 파일 경로
SQLITE_PATH=cms.db

# postgres 사용 시 DSN (DB_DRIVER=postgres 일 때만 사용)
# DB_DSN=host=localhost user=cms password=cms dbname=cms port=5432 sslmode=disable TimeZone=Asia/Seoul
DB_DSN=

# 관리자(admin)/공개 API CORS 허용 Origin (콤마 구분, '*' 면 전체 허용)
# 새 프론트 포트가 생기면 콤마로 추가하세요. 예: ...,http://localhost:5175
# (5173 대시보드 / 5174 web / 4173 vite preview 등)
CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:4173,http://localhost:9000,http://localhost:3000
# JWT 서명 키 (운영에서는 반드시 강력한 무작위 값으로 교체)
JWT_SECRET=dev-insecure-secret-change-me
# 액세스/리프레시 토큰 만료
JWT_ACCESS_TTL_MIN=60
JWT_REFRESH_TTL_HOURS=168
# admin_users 가 비어있을 때 생성되는 개발용 기본 계정 비밀번호
# (admin@example.com / editor@example.com / viewer@example.com 공통)
ADMIN_SEED_PASSWORD=secret
# 인증 엔드포인트(/auth/login·register) IP 당 레이트 리밋 (0 이면 비활성)
AUTH_RATE_LIMIT_PER_MIN=10
AUTH_RATE_LIMIT_BURST=5
