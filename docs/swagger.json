{
  "openapi": "3.0.3",
  "info": {
    "title": "CMS Dashboard API",
    "version": "0.1.0",
    "description": "refine 대시보드(`dashboard/`)가 호출하는 백엔드 REST API.\n\n데이터 프로바이더로 `@refinedev/simple-rest`(json-server 스타일 규약)를 사용한다. 따라서 아래 규약을 반드시 지켜야 한다.\n\n- 목록 조회 페이지네이션: `_start`(offset, 포함), `_end`(offset, 미포함). 반환 배열과 함께 전체 개수를 **`X-Total-Count` 응답 헤더**로 반드시 내려준다.\n- 정렬: `_sort`(필드명, 콤마 구분), `_order`(`asc`/`desc`, 콤마 구분).\n- 필터: `{field}_like`, `{field}_ne`, `{field}_gte`, `{field}_lte`, `{field}_gt`, `{field}_lt`, 그리고 정확히 일치는 `{field}=값`.\n- 수정은 `PATCH /{resource}/{id}` 를 사용한다(부분 수정).\n- `useMany`(연관 데이터 조회)는 simple-rest에서 별도 엔드포인트 없이 `GET /{resource}/{id}` 를 id 개수만큼 호출한다.\n- CORS 사용 시 `Access-Control-Expose-Headers: X-Total-Count` 설정이 필요하다."
  },
  "servers": [{ "url": "http://localhost:9000", "description": "로컬 개발 서버" }],
  "tags": [
    { "name": "posts", "description": "게시글" },
    { "name": "categories", "description": "카테고리" },
    { "name": "tags", "description": "태그" },
    { "name": "comments", "description": "댓글" }
  ],
  "paths": {
    "/posts": {
      "get": {
        "tags": ["posts"],
        "summary": "게시글 목록 조회",
        "parameters": [
          { "$ref": "#/components/parameters/start" },
          { "$ref": "#/components/parameters/end" },
          { "$ref": "#/components/parameters/sort" },
          { "$ref": "#/components/parameters/order" },
          { "name": "title_like", "in": "query", "schema": { "type": "string" }, "description": "제목 부분 일치 필터" },
          { "name": "status", "in": "query", "schema": { "type": "string", "enum": ["draft", "published", "rejected"] }, "description": "상태 정확 일치 필터" },
          { "name": "categoryId", "in": "query", "schema": { "type": "integer" }, "description": "카테고리 정확 일치 필터" }
        ],
        "responses": {
          "200": {
            "description": "게시글 목록",
            "headers": { "X-Total-Count": { "$ref": "#/components/headers/XTotalCount" } },
            "content": {
              "application/json": {
                "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Post" } }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["posts"],
        "summary": "게시글 생성",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PostInput" } } }
        },
        "responses": {
          "201": {
            "description": "생성된 게시글",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Post" } } }
          },
          "400": { "$ref": "#/components/responses/BadRequest" }
        }
      }
    },
    "/posts/{id}": {
      "parameters": [{ "$ref": "#/components/parameters/idPath" }],
      "get": {
        "tags": ["posts"],
        "summary": "게시글 단건 조회",
        "responses": {
          "200": {
            "description": "게시글",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Post" } } }
          },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "patch": {
        "tags": ["posts"],
        "summary": "게시글 수정(부분)",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PostInput" } } }
        },
        "responses": {
          "200": {
            "description": "수정된 게시글",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Post" } } }
          },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "delete": {
        "tags": ["posts"],
        "summary": "게시글 삭제",
        "responses": {
          "200": { "description": "삭제 성공(빈 객체 또는 삭제된 리소스)", "content": { "application/json": { "schema": { "type": "object" } } } },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/categories": {
      "get": {
        "tags": ["categories"],
        "summary": "카테고리 목록 조회",
        "parameters": [
          { "$ref": "#/components/parameters/start" },
          { "$ref": "#/components/parameters/end" },
          { "$ref": "#/components/parameters/sort" },
          { "$ref": "#/components/parameters/order" },
          { "name": "title_like", "in": "query", "schema": { "type": "string" }, "description": "제목 부분 일치 필터" }
        ],
        "responses": {
          "200": {
            "description": "카테고리 목록",
            "headers": { "X-Total-Count": { "$ref": "#/components/headers/XTotalCount" } },
            "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Category" } } } }
          }
        }
      },
      "post": {
        "tags": ["categories"],
        "summary": "카테고리 생성",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CategoryInput" } } } },
        "responses": {
          "201": { "description": "생성된 카테고리", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Category" } } } },
          "400": { "$ref": "#/components/responses/BadRequest" }
        }
      }
    },
    "/categories/{id}": {
      "parameters": [{ "$ref": "#/components/parameters/idPath" }],
      "get": {
        "tags": ["categories"],
        "summary": "카테고리 단건 조회",
        "responses": {
          "200": { "description": "카테고리", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Category" } } } },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "patch": {
        "tags": ["categories"],
        "summary": "카테고리 수정(부분)",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CategoryInput" } } } },
        "responses": {
          "200": { "description": "수정된 카테고리", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Category" } } } },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "delete": {
        "tags": ["categories"],
        "summary": "카테고리 삭제",
        "responses": {
          "200": { "description": "삭제 성공", "content": { "application/json": { "schema": { "type": "object" } } } },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/tags": {
      "get": {
        "tags": ["tags"],
        "summary": "태그 목록 조회",
        "parameters": [
          { "$ref": "#/components/parameters/start" },
          { "$ref": "#/components/parameters/end" },
          { "$ref": "#/components/parameters/sort" },
          { "$ref": "#/components/parameters/order" },
          { "name": "title_like", "in": "query", "schema": { "type": "string" }, "description": "제목 부분 일치 필터" }
        ],
        "responses": {
          "200": {
            "description": "태그 목록",
            "headers": { "X-Total-Count": { "$ref": "#/components/headers/XTotalCount" } },
            "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Tag" } } } }
          }
        }
      },
      "post": {
        "tags": ["tags"],
        "summary": "태그 생성",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/TagInput" } } } },
        "responses": {
          "201": { "description": "생성된 태그", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Tag" } } } },
          "400": { "$ref": "#/components/responses/BadRequest" }
        }
      }
    },
    "/tags/{id}": {
      "parameters": [{ "$ref": "#/components/parameters/idPath" }],
      "get": {
        "tags": ["tags"],
        "summary": "태그 단건 조회",
        "responses": {
          "200": { "description": "태그", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Tag" } } } },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "patch": {
        "tags": ["tags"],
        "summary": "태그 수정(부분)",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/TagInput" } } } },
        "responses": {
          "200": { "description": "수정된 태그", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Tag" } } } },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "delete": {
        "tags": ["tags"],
        "summary": "태그 삭제",
        "responses": {
          "200": { "description": "삭제 성공", "content": { "application/json": { "schema": { "type": "object" } } } },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/comments": {
      "get": {
        "tags": ["comments"],
        "summary": "댓글 목록 조회",
        "parameters": [
          { "$ref": "#/components/parameters/start" },
          { "$ref": "#/components/parameters/end" },
          { "$ref": "#/components/parameters/sort" },
          { "$ref": "#/components/parameters/order" },
          { "name": "postId", "in": "query", "schema": { "type": "integer" }, "description": "게시글 정확 일치 필터" },
          { "name": "status", "in": "query", "schema": { "type": "string", "enum": ["draft", "published", "rejected"] }, "description": "상태 정확 일치 필터" }
        ],
        "responses": {
          "200": {
            "description": "댓글 목록",
            "headers": { "X-Total-Count": { "$ref": "#/components/headers/XTotalCount" } },
            "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Comment" } } } }
          }
        }
      },
      "post": {
        "tags": ["comments"],
        "summary": "댓글 생성",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CommentInput" } } } },
        "responses": {
          "201": { "description": "생성된 댓글", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Comment" } } } },
          "400": { "$ref": "#/components/responses/BadRequest" }
        }
      }
    },
    "/comments/{id}": {
      "parameters": [{ "$ref": "#/components/parameters/idPath" }],
      "get": {
        "tags": ["comments"],
        "summary": "댓글 단건 조회",
        "responses": {
          "200": { "description": "댓글", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Comment" } } } },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "patch": {
        "tags": ["comments"],
        "summary": "댓글 수정(부분)",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CommentInput" } } } },
        "responses": {
          "200": { "description": "수정된 댓글", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Comment" } } } },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "delete": {
        "tags": ["comments"],
        "summary": "댓글 삭제",
        "responses": {
          "200": { "description": "삭제 성공", "content": { "application/json": { "schema": { "type": "object" } } } },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "idPath": { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" }, "description": "리소스 ID" },
      "start": { "name": "_start", "in": "query", "schema": { "type": "integer", "minimum": 0 }, "description": "페이지네이션 시작 offset(포함). 예: 0" },
      "end": { "name": "_end", "in": "query", "schema": { "type": "integer", "minimum": 0 }, "description": "페이지네이션 끝 offset(미포함). 예: 10 (0~9 반환)" },
      "sort": { "name": "_sort", "in": "query", "schema": { "type": "string" }, "description": "정렬 필드(콤마 구분). 예: id 또는 createdAt,id" },
      "order": { "name": "_order", "in": "query", "schema": { "type": "string" }, "description": "정렬 방향(콤마 구분, _sort와 1:1). 예: desc 또는 desc,asc" }
    },
    "headers": {
      "XTotalCount": {
        "description": "필터 적용 후 전체 레코드 수. 페이지네이션 계산에 필수.",
        "schema": { "type": "integer" }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "잘못된 요청",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      },
      "NotFound": {
        "description": "리소스를 찾을 수 없음",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      }
    },
    "schemas": {
      "Post": {
        "type": "object",
        "required": ["id", "title", "content", "status", "categoryId", "tagIds", "createdAt", "updatedAt"],
        "properties": {
          "id": { "type": "integer", "readOnly": true, "example": 1 },
          "title": { "type": "string", "example": "첫 번째 게시글" },
          "content": { "type": "string", "example": "본문 내용" },
          "status": { "type": "string", "enum": ["draft", "published", "rejected"], "example": "published" },
          "categoryId": { "type": "integer", "example": 2 },
          "tagIds": { "type": "array", "items": { "type": "integer" }, "example": [1, 3] },
          "createdAt": { "type": "string", "format": "date-time", "readOnly": true },
          "updatedAt": { "type": "string", "format": "date-time", "readOnly": true }
        }
      },
      "PostInput": {
        "type": "object",
        "required": ["title", "content", "status", "categoryId"],
        "properties": {
          "title": { "type": "string" },
          "content": { "type": "string" },
          "status": { "type": "string", "enum": ["draft", "published", "rejected"], "default": "draft" },
          "categoryId": { "type": "integer" },
          "tagIds": { "type": "array", "items": { "type": "integer" }, "default": [] }
        }
      },
      "Category": {
        "type": "object",
        "required": ["id", "title", "createdAt", "updatedAt"],
        "properties": {
          "id": { "type": "integer", "readOnly": true, "example": 1 },
          "title": { "type": "string", "example": "공지사항" },
          "createdAt": { "type": "string", "format": "date-time", "readOnly": true },
          "updatedAt": { "type": "string", "format": "date-time", "readOnly": true }
        }
      },
      "CategoryInput": {
        "type": "object",
        "required": ["title"],
        "properties": { "title": { "type": "string" } }
      },
      "Tag": {
        "type": "object",
        "required": ["id", "title", "createdAt", "updatedAt"],
        "properties": {
          "id": { "type": "integer", "readOnly": true, "example": 1 },
          "title": { "type": "string", "example": "react" },
          "createdAt": { "type": "string", "format": "date-time", "readOnly": true },
          "updatedAt": { "type": "string", "format": "date-time", "readOnly": true }
        }
      },
      "TagInput": {
        "type": "object",
        "required": ["title"],
        "properties": { "title": { "type": "string" } }
      },
      "Comment": {
        "type": "object",
        "required": ["id", "postId", "text", "status", "createdAt", "updatedAt"],
        "properties": {
          "id": { "type": "integer", "readOnly": true, "example": 1 },
          "postId": { "type": "integer", "example": 1 },
          "text": { "type": "string", "example": "좋은 글이네요." },
          "status": { "type": "string", "enum": ["draft", "published", "rejected"], "example": "published" },
          "createdAt": { "type": "string", "format": "date-time", "readOnly": true },
          "updatedAt": { "type": "string", "format": "date-time", "readOnly": true }
        }
      },
      "CommentInput": {
        "type": "object",
        "required": ["postId", "text", "status"],
        "properties": {
          "postId": { "type": "integer" },
          "text": { "type": "string" },
          "status": { "type": "string", "enum": ["draft", "published", "rejected"], "default": "draft" }
        }
      },
      "Error": {
        "type": "object",
        "properties": { "message": { "type": "string" } }
      }
    }
  }
}
